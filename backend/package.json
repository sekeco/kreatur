    "@zenstackhq/better-auth": "^3.8.3",
    "@zenstackhq/orm": "^3.8.3",
    "@zenstackhq/schema": "^3.8.3",
    "better-auth": "^1.6.23",
    "elysia": "^1.4.29",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.1.0",
