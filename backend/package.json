  "scripts": {
    "auth:generate": "bun x @better-auth/cli generate",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun --env-file ../.env --watch src/index.ts",
    "email": "email dev --dir src/email/templates",
